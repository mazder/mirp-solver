
# =========================
# Stage 1: Build dependencies
# =========================
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /workspace

# Step 1: Install software-properties-common to use add-apt-repository
RUN apt update && \
    apt install -y software-properties-common curl && \
    rm -rf /var/lib/apt/lists/*

####################################
# Install latest Python 3.13
####################################
RUN add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y python3.13 python3.13-venv python3.13-dev && \
    # make Python 3.13 default without touching 3.12
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.13 2 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.13 2

# Install pip for Python 3.13
RUN curl -sS https://bootstrap.pypa.io/get-pip.py -o get-pip.py && \
    python3 get-pip.py && rm get-pip.py

####################################
# Install system dependencies
####################################
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    unzip \
    python3-setuptools \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libdcmtk-dev \
    libeigen3-dev \
    libtbb-dev \
    libatlas-base-dev \
    gfortran \
    pkg-config \
    python3-numpy \
    libfftw3-dev \
    libboost-all-dev \
    libncurses5-dev \
    libfreetype6-dev \
    libx11-dev \
    libxi-dev \
    libxmu-dev \
    libgtk-3-dev \
    libhdf5-dev \
    libyaml-cpp-dev \
    lua5.3 \
    lua5.3-dev \
    swig \
    libgtest-dev \
    libfltk1.3-dev \
    libsz2 \
    zlib1g-dev \
    libssl-dev \
    vim \
    freeglut3-dev \
    mesa-common-dev \
    gdb \
    tcl-dev \
    tk-dev \
    g++ \
    && rm -rf /var/lib/apt/lists/*

####################################
# Build and install CMake
####################################
RUN cd /opt && \
    wget https://github.com/Kitware/CMake/releases/download/v3.31.5/cmake-3.31.5.tar.gz && \
    tar -xzvf cmake-3.31.5.tar.gz && \
    cd cmake-3.31.5 && \
    ./bootstrap --prefix=/opt/cmake && \
    make -j$(nproc) && \
    make install && \
    rm -rf /opt/cmake-3.31.5.tar.gz /opt/cmake-3.31.5

ENV PATH="/opt/cmake/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/cmake/lib:${LD_LIBRARY_PATH}"

####################################
# Download and install MPICH from source
####################################
RUN cd /opt && \
    wget https://www.mpich.org/static/downloads/4.2.3/mpich-4.2.3.tar.gz && \
    tar -xzf mpich-4.2.3.tar.gz && \
    cd mpich-4.2.3 && \
    ./configure --prefix=/opt/mpich --enable-shared --enable-fortran --enable-cxx && \
    make -j$(nproc) && \
    make install && \
    rm -rf /opt/mpich-4.2.3.tar.gz /opt/mpich-4.2.3

ENV PATH="/opt/mpich/bin:$PATH"
ENV LD_LIBRARY_PATH="/opt/mpich/lib:$LD_LIBRARY_PATH"

####################################
# Download and install HDF5 with MPI
####################################
RUN cd /opt && \
    wget https://support.hdfgroup.org/ftp/HDF5/releases/hdf5-1.12/hdf5-1.12.0/src/hdf5-1.12.0.tar.gz && \
    tar -xzf hdf5-1.12.0.tar.gz && \
    cd hdf5-1.12.0 && \
    ./configure --prefix=/opt/hdf5 \
        MPICC=/opt/mpich/bin/mpicc \
        MPIFC=/opt/mpich/bin/mpifort \
        LDFLAGS="-L/opt/mpich/lib -lmpi" \
        CPPFLAGS="-I/opt/mpich/include" \
        --enable-shared \
        --enable-parallel \
        --enable-hl \
        --enable-fortran \
        --enable-cxx \
        --enable-unsupported && \
    make -j$(nproc) && \
    make install && \
    rm -rf /opt/hdf5-1.12.0.tar.gz /opt/hdf5-1.12.0

# Add HDF5 to PATH and library search paths
ENV PATH="/opt/hdf5/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/hdf5/lib:${LD_LIBRARY_PATH}"
ENV HDF5_INCLUDE_DIR="/opt/hdf5/include"

# Build and install VTK
RUN cd /opt && \
    git clone https://gitlab.kitware.com/vtk/vtk.git CVTK && \
    cd CVTK && \
    git submodule update --init && \
    mkdir build && cd build && \
    cmake .. \
      -DVTK_RENDERING_PYTHON_TK_WIDGETS=ON \
      -DVTK_Group_Rendering=ON \
      -DVTK_USE_OPENGL=ON \
      -DVTK_USE_GL2PS=ON \
      -DVTK_WRAP_PYTHON=ON \
      -DPYTHON_EXECUTABLE=/usr/bin/python3.13 \
      -DVTK_GROUP_IO=ON \
      -DVTK_USE_VTKDICOM=ON \
      -DVTK_USE_VTKSTL=ON \
      -DVTK_USE_VTKTIFF=ON \
      -DVTK_GROUP_Visualization=ON \
      -DVTK_RENDERING=ON \
      -DVTK_USE_CUDA=ON \
      -DVTK_USE_IMAGE_FILTERS=ON \
      -DVTK_USE_MPI=ON \
      -DCMAKE_BUILD_TYPE=Release \
      -DVTK_BUILD_ALL=ON \
      -DCMAKE_INSTALL_PREFIX=/opt/vtk \
      -DVTK_GROUP_ENABLE_Rendering=YES \
      -DHDF5_DIR=/opt/hdf5/lib/cmake/hdf5 \
      -DVTK_GROUP_ENABLE_Imaging=YES && \
    make -j$(nproc) && \
    make install && \
    rm -rf /opt/CVTK

# Set environment variables for VTK
ENV PATH=/opt/vtk/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/vtk/lib:${LD_LIBRARY_PATH}
ENV PYTHONPATH=/opt/vtk/lib/python3.13/site-packages:${PYTHONPATH}

RUN apt-get update && apt-get install -y \
    libopencv-dev \
    libopencv-core-dev \
    libopencv-imgcodecs-dev \
    libopencv-highgui-dev \
    && apt-get clean

# Install Python libraries for PyTorch and OpenCV using Python 3.13
RUN python3.13 -m pip install --upgrade pip && \
    python3.13 -m pip install torch torchvision torchaudio && \
    python3.13 -m pip install opencv-python-headless && \
    python3.13 -m pip install opencv-contrib-python-headless

# Install OpenCV from source to ensure C++ bindings are available
RUN cd /opt && \
    git clone --recursive https://github.com/opencv/opencv.git && \
    git clone --recursive https://github.com/opencv/opencv_contrib.git && \
    cd opencv && \
    mkdir build && cd build && \
    cmake -D CMAKE_BUILD_TYPE=Release \
          -D CMAKE_INSTALL_PREFIX=/usr/local \
          -D WITH_CUDA=ON \
          -D WITH_CUDNN=ON \
          -D OPENCV_EXTRA_MODULES_PATH=../../opencv_contrib/modules \
          -D BUILD_EXAMPLES=ON \
          -D INSTALL_C_EXAMPLES=ON \
          -D INSTALL_PYTHON_EXAMPLES=ON \
          -D BUILD_opencv_python3=ON .. && \
    make -j$(nproc) && \
    make install && \
    cd /opt && \
    rm -rf opencv opencv_contrib

# Download and install PyTorch C++ API (LibTorch)
RUN cd /opt && \
    wget https://download.pytorch.org/libtorch/cu121/libtorch-shared-with-deps-2.5.1%2Bcu121.zip && \
    unzip libtorch-shared-with-deps-2.5.1+cu121.zip -d /opt/ && \
    rm libtorch-shared-with-deps-2.5.1+cu121.zip

# Copy modified Makefiles for CGNS tools
COPY Makefile.unix1 /workspace/Makefile.unix1
COPY Makefile.unix2 /workspace/Makefile.unix2
COPY Makefile.unix3 /workspace/Makefile.unix3

# Download, build, and install CGNS
RUN cd /opt && \
    git clone https://github.com/CGNS/CGNS.git && \
    cd CGNS && \
    git checkout v4.1.1 && \
    cmake -B build -S . -DCMAKE_PREFIX_PATH=/opt/hdf5 -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/opt/cgns && \
    cmake --build build --target all -j$(nproc) && \
    mv /opt/hdf5/lib/libhdf5.a /opt/hdf5/lib/libhdf5.a_back && \
    cd src && \
    ./configure --enable-cgnstools \
                --prefix=/opt/cgns \
                --with-tcl=/usr/lib/tcl8.6 \
                --with-tk=/usr/lib/tk8.6 \
                --with-hdf5=/opt/hdf5 \
                LDFLAGS="-L/opt/hdf5/lib -lhdf5 $LDFLAGS" \
                CFLAGS="-I/opt/mpich/include $CFLAGS" && \
    cp /workspace/Makefile.unix1 /opt/CGNS/src/cgnstools/cgnscalc/Makefile.unix && \
    cp /workspace/Makefile.unix2 /opt/CGNS/src/cgnstools/cgnsview/Makefile.unix && \
    cp /workspace/Makefile.unix3 /opt/CGNS/src/cgnstools/utilities/Makefile.unix && \
    make -j$(nproc) && \
    make install && \
    rm -rf /opt/CGNS && \
    mv /opt/hdf5/lib/libhdf5.a_back /opt/hdf5/lib/libhdf5.a

# Set environment variables for CGNS
ENV PATH=/opt/cgns/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/cgns/lib:${LD_LIBRARY_PATH}

# Python packages
RUN pip3 install --upgrade pip && \
    pip3 install pandas scikit-learn scikit-image matplotlib seaborn \
                 openpyxl xgboost imbalanced-learn sweetviz catboost lightgbm \
                 pydicom monai tensorflow

# cuDNN paths (Python 3.13)
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.13/dist-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH
RUN ln -sf /usr/local/lib/python3.13/dist-packages/nvidia/cudnn/lib/libcudnn.so.9 /usr/lib/x86_64-linux-gnu/libcudnn.so && \
    ln -sf /usr/local/lib/python3.13/dist-packages/nvidia/cudnn/lib/libcudnn.so.9 /usr/lib/x86_64-linux-gnu/libcudnn.so.9

# pybind11 and system dependencies
RUN apt-get update && apt-get install -y pybind11-dev build-essential \
    libgmp-dev libmpfr-dev libmpc-dev flex texinfo libisl-dev wget && \
    apt-get clean

RUN python3.13 -m pip install --upgrade pip setuptools wheel && \
    python3.13 -m pip install pybind11==2.13.6

# Install Python packages required for DICOM → NIfTI → PNG
RUN python3.13 -m pip install --no-cache-dir nibabel pydicom pillow numpy

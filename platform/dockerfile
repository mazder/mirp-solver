# ====== Install netCDF-C (with CMake support) ======
RUN apt-get update && apt-get install -y \
    libnetcdf-dev \
    netcdf-bin

# ========== Install vtkbone ==========
RUN git clone https://github.com/Numerics88/vtkbone.git /opt/vtkbone && \
    cd /opt/vtkbone && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DVTKBONE_BUILD_PYTHON_BINDINGS=ON -DCMAKE_INSTALL_PREFIX=/opt/VTKbone -DBUILD_SHARED_LIBS=ON &&\
    make -j$(nproc) && \
    make install && \
    cd /opt && rm -rf /opt/vtkbone

RUN ln -sf /opt/VTKbone/lib/libvtkbone-9.5.so.2.0.0 /opt/VTKbone/lib/libvtkbone.so
ENV LD_LIBRARY_PATH="/opt/VTKbone/lib:$LD_LIBRARY_PATH"
ENV PYTHONPATH=/opt/VTKbone/lib/python3.9/site-packages:${PYTHONPATH}

RUN cd /opt && \
    git clone https://github.com/Bonelab/Ogo.git && \
    cd Ogo && \
    pip install -e .

RUN pip install nibabel

RUN apt-get update && apt-get install -y python3.10 python3.10-venv python3.10-dev
# 2. Create venv and install nnUNet inside it
RUN python3.10 -m venv /opt/venv_unet && \
    /opt/venv_unet/bin/pip install --upgrade pip && \
    cd /opt && \
    git clone https://github.com/MIC-DKFZ/nnUNet.git && \
    /opt/venv_unet/bin/pip install -e /opt/nnUNet


# Copy the test image (test.jpg) into the container's workspace
COPY test.jpeg /workspace/test.jpeg

# Set working directory
WORKDIR /workspace

# Optional: Run the test script when the container starts
CMD ["bash"]
